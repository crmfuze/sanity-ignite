{
  "name": "@10up/sanity-ignite",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "next:dev": "next dev --turbopack",
    "next:build": "yarn run sanity:typegen && next build",
    "next:start": "next start",
    "next:debug": "NEXT_PRIVATE_DEBUG_CACHE=1 next:build && next:start",
    "lint": "next lint",
    "dev": "npm-run-all --parallel --race next:dev watch-typegen",
    "build": "yarn run next:build",
    "start": "yarn run next:start",
    "sanity:typegen": "mkdir -p ./.sanity && sanity schema extract --path=.sanity/schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "watch-typegen": "tsx watch-typegen.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.1",
    "@medusajs/icons": "^2.7.0",
    "@medusajs/js-sdk": "^2.7.0",
    "@medusajs/ui": "^4.0.8",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-slot": "^1.2.0",
    "@sanity/assist": "^3.0.8",
    "@sanity/icons": "^3.4.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/react-loader": "^1.10.28",
    "@sanity/vision": "^3.81.0",
    "@stripe/react-stripe-js": "^3.6.0",
    "@stripe/stripe-js": "^7.1.0",
    "@tanstack/react-form": "^1.12.4",
    "@tinloof/sanity-studio": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.476.0",
    "next": "^15.3.1",
    "next-sanity": "^9.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^2.16.0",
    "resend": "^4.5.0",
    "sanity": "^3.88.3",
    "sanity-plugin-icon-picker": "^4.0.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "valibot": "^1.0.0-beta.14"
  },
  "devDependencies": {
    "@medusajs/types": "^2.7.0",
    "@medusajs/ui-preset": "^2.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/chokidar": "^2.1.7",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^4.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.1",
    "eslint-plugin-import": "^2.31.0",
    "groq": "^3.79.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "tailwindcss-radix": "^4.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --cache --fix",
    "*.{ts,tsx,js,css,md}": "prettier --write"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
